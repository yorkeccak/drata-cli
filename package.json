{
  "name": "drata-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Drata CLI for agentic compliance - manage your entire Drata compliance platform from the terminal",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.0.0",
  "dependencies": {
    "commander": "^14.0.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
